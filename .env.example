# SecureMail Enterprise — copy to .env and customize
SECRET_KEY=replace-with-openssl-rand-hex-32
LICENSE_REQUIRED=true

SES_DOMAIN=ses
SES_DOMAINS=["ses"]
SES_MAIL_HOST=mail.example.com

SMTP_INBOUND_ENABLED=true
SMTP_INBOUND_PORT=2525

# Outbound smart-host (recommended for production)
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_TLS=true

DKIM_SELECTOR=ses
